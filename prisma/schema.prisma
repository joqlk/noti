generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Note {
  id        String    @id @default(cuid())
  toName    String
  message   String
  fromAlias String?
  createdAt DateTime  @default(now())
  comments  Comment[]

  @@index([toName])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  noteId    String
  message   String
  fromAlias String?
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([createdAt])
}
